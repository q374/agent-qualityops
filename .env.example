# 默认使用不产生费用的确定性演示模式。
QUALITYOPS_MODEL_MODE=demo
QUALITYOPS_BUDGET_CNY=5

# 真实评测时在本地复制为 .env 并填写。不要提交 .env。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 2026-09-18 官方高峰价，单位：元/百万 tokens；可按官方价格调整。
DEEPSEEK_INPUT_CNY_PER_MILLION=2
DEEPSEEK_OUTPUT_CNY_PER_MILLION=8
