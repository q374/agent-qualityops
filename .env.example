# 默认使用不产生费用的确定性演示模式。
QUALITYOPS_MODEL_MODE=demo
QUALITYOPS_BUDGET_CNY=5

# 真实评测时只在本地 .env 中填写；不要提交或粘贴到聊天。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=30
# Flash 默认开启思考模式；本项目默认关闭，确保有限输出预算优先生成最终回答。
DEEPSEEK_THINKING_MODE=disabled

# 2026-09-18 的保守预算换算示例：官方峰值美元价按 7.2 汇率折算并向上取整。
# 实际账单以 DeepSeek 官方计费为准，价格变化时应同步调整。
DEEPSEEK_INPUT_CNY_PER_MILLION=2.2
DEEPSEEK_OUTPUT_CNY_PER_MILLION=8.7
